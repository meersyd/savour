{
  "expo": {
    "name": "Savour",
    "slug": "savour-recipe-app",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.meersyd.savour"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#46543C",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.meersyd.savour",
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Savour uses your selected photos to illustrate recipes saved on your device.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font"
    ],
    "backgroundColor": "#FAF8F5"
  }
}
